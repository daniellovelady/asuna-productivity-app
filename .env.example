VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Dev only — FullCalendar Phase 0A compatibility spike (renderer). Set to 1 in local .env and restart npm start.
# VITE_FULLCALENDAR_SPIKE=1

COACH_BACKEND_URL=http://127.0.0.1:8000
COACH_REQUEST_TIMEOUT_MS=60000

# Google Calendar (Desktop OAuth client — main process only, via vite.main.config.ts)
GOOGLE_OAUTH_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-desktop-client-secret

# Optional RLS isolation test (vitest taskRlsIsolation.test.ts):
# RLS_TEST_ACCOUNT_A_EMAIL=...
# RLS_TEST_ACCOUNT_A_PASSWORD=...
# RLS_TEST_ACCOUNT_B_EMAIL=...
# RLS_TEST_ACCOUNT_B_PASSWORD=...
